NODE_ENV=development
PORT=3000

DATABASE_URL=

CORS_ORIGIN=

LOG_LEVEL=

# Only read by docker-compose.yml, never by the API itself. Compose passes a
# connection string built from these to its own containers, so DATABASE_URL
# above can stay empty when the whole stack runs in Docker.
POSTGRES_USER=spc
POSTGRES_PASSWORD=
POSTGRES_DB=automotive_marketplace

# API_PORT=3000
# IMAGE=ghcr.io/<owner>/dri-assessment:latest
